html {
    scroll-behavior: smooth;
}

:root {

    --bg: #080b0f;

    --bg-secondary: #10151b;


    --burgundy: #7d1630;

    --burgundy-light: #a51d42;


    --green: #285c4b;


    --text: #f0ece5;

    --text-muted: #969da3;


    --border: rgba(255, 255, 255, 0.11);

}


/* -------------------- */
/* RESET */
/* -------------------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: var(--bg);
    color: var(--text);

    font-family: "Inter", sans-serif;

    font-weight: 400;
}


/* -------------------- */
/* HEADER */
/* -------------------- */

.header {
    height: 80px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 55px;

    border-bottom: 1px solid var(--border);
}


/* Logo */

.logo {
    color: var(--text);

    text-decoration: none;

    font-size: 24px;
    font-weight: bold;
}


/* Navigation */

.nav {
    display: flex;
    gap: 30px;
}

.nav a {
    color: var(--text-muted);

    text-decoration: none;

    font-size: 13px;

    transition: color 0.3s ease;
}

.nav a:hover {
    color: var(--text);
}


/* Bouton CV */

.cv-button {
    color: var(--text);

    text-decoration: none;

    border: 1px solid var(--border);

    padding: 10px 18px;

    border-radius: 30px;

    font-size: 12px;
}


/* -------------------- */
/* HERO */
/* -------------------- */

.hero {
    min-height: calc(100vh - 80px);

    display: grid;

    grid-template-columns: 1fr 1fr;

    position: relative;

    overflow: hidden;
}


/* Partie gauche */

.hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 80px;
}


/* Petit titre */

.eyebrow {
    color: var(--text-muted);

    font-size: 11px;

    letter-spacing: 4px;

    margin-bottom: 20px;
}


/* Gros titre */

.hero h1 {
    font-family: "DM Serif Display", serif;

    font-size: clamp(55px, 7vw, 100px);

    font-weight: 400;

    line-height: 0.95;

    margin-bottom: 25px;
}


/* Sous-titre */

.hero h2 {
    font-size: 18px;

    font-weight: 400;

    color: var(--text-muted);

    margin-bottom: 25px;
}


/* Description */

.hero-description {
    max-width: 480px;

    color: var(--text-muted);

    font-size: 15px;

    line-height: 1.8;

    margin-bottom: 35px;
}


/* -------------------- */
/* BOUTONS */
/* -------------------- */

.hero-buttons {
    display: flex;

    gap: 15px;
}

.button {
    display: inline-block;

    padding: 14px 24px;

    border-radius: 30px;

    text-decoration: none;

    font-size: 13px;

    transition: 0.3s ease;
}


/* Bouton principal */

.button-primary {
    background: var(--burgundy);

    color: white;
}

.button-primary:hover {
    background: var(--burgundy-light);

    transform: translateY(-2px);
}


/* Bouton secondaire */

.button-secondary {
    color: var(--text);

    border: 1px solid var(--border);
}

.button-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
}


/* -------------------- */
/* IMAGE */
/* -------------------- */

.hero-image {
    display: flex;

    align-items: center;
    justify-content: center;

    padding: 50px;

    background:
        linear-gradient(
            135deg,
            rgba(133, 15, 43, 0.5),
            rgba(8, 13, 19, 0.2)
        );
}


/* Faux emplacement de l'image */

/* -------------------- */
/* HERO IMAGE */
/* -------------------- */

.hero-image {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 70% 40%,
            rgba(133, 15, 43, 0.35),
            transparent 50%
        ),
        #0b1218;
}


/* -------------------- */
/* PHOTO */
/* -------------------- */

.hero-photo {
    position: relative;

    z-index: 2;

    width: 65%;
    height: 75%;

    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.15);

    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.5);
}


.hero-photo img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;

    filter: brightness(0.75) saturate(0.8);
}

.shape {
    position: absolute;

    z-index: 1;
}


/* Forme bordeaux */

.shape-burgundy {
    width: 400px;
    height: 400px;

    background: var(--burgundy);

    top: -120px;
    left: -100px;

    transform: rotate(25deg);

    opacity: 0.65;

    clip-path: polygon(
        0 0,
        100% 0,
        70% 100%,
        0 70%
    );
}


/* Forme verte */

.shape-green {
    width: 350px;
    height: 350px;

    background: var(--green);

    bottom: -130px;
    right: -100px;

    transform: rotate(35deg);

    opacity: 0.55;

    clip-path: polygon(
        30% 0,
        100% 30%,
        100% 100%,
        0 70%
    );
}

.hero-image::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
        radial-gradient(
            circle at 50% 50%,
            transparent 20%,
            rgba(0, 0, 0, 0.45) 100%
        );

    z-index: 3;

    pointer-events: none;
}

@media (max-width: 768px) {

    .header {
        padding: 0 20px;
    }

    .nav {
        display: none;
    }

    .cv-button {
        padding: 8px 14px;
    }


    .hero {
        grid-template-columns: 1fr;
    }


    .hero-content {
        padding: 70px 25px;
    }


    .hero h1 {
        font-size: 58px;
    }


    .hero-image {
        min-height: 500px;
    }


    .hero-photo {
        width: 75%;
        height: 75%;
    }

    .projects {
        padding: 80px 25px;
    }


    .projects-header {
        display: block;

        margin-bottom: 40px;
    }


    .projects-link {
        display: inline-block;

        margin-top: 25px;
    }


    .projects-grid {
        grid-template-columns: 1fr;

        gap: 50px;
    }


    .project-image {
        height: 420px;
    }


    .project-arrow {
        opacity: 1;

        transform: none;
    }

    .skills {
        padding: 80px 25px;
    }


    .skills-header {
        margin-bottom: 50px;
    }


    .skill {
        grid-template-columns: 40px 1fr;

        gap: 20px;

        align-items: start;
    }


    .skill-main h3 {
        font-size: 24px;
    }


    .skill-tags {
        grid-column: 2;

        justify-content: flex-start;
    }

    .contact {
        padding: 90px 25px;
    }


    .contact-header {
        margin-bottom: 60px;
    }


    .contact-header h2 {
        font-size: 58px;
    }


    .contact-content {
        flex-direction: column;

        align-items: flex-start;
    }


    .contact-info {
        width: 100%;

        flex-direction: column;

        gap: 30px;
    }


    .contact-button {
        width: 130px;
        height: 130px;

        align-self: flex-end;
    }
}

/* -------------------- */
/* ABOUT */
/* -------------------- */

.about {
    min-height: 700px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 80px;

    padding: 120px 80px;

    border-top: 1px solid var(--border);
}


/* Contenu */

.about-content {
    display: flex;

    flex-direction: column;

    justify-content: center;
}


/* Petit titre */

.section-label {
    color: var(--text-muted);

    font-size: 10px;

    letter-spacing: 4px;

    margin-bottom: 18px;
}


/* Gros titre */

.about h2 {
    font-family: "DM Serif Display", serif;

    font-size: clamp(45px, 5vw, 70px);

    font-weight: 400;

    line-height: 1;

    margin-bottom: 30px;
}


/* Texte */

.about-text {
    max-width: 540px;

    color: var(--text-muted);

    font-size: 14px;

    line-height: 1.8;

    margin-bottom: 15px;
}


/* -------------------- */
/* INFORMATIONS */
/* -------------------- */

.about-infos {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 25px;

    margin-top: 30px;

    margin-bottom: 35px;
}


.info {
    display: flex;

    align-items: flex-start;

    gap: 12px;
}


.info-icon {
    width: 40px;
    height: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border: 1px solid var(--border);

    border-radius: 50%;

    color: var(--burgundy-light);

    font-size: 16px;
}


.info-title,
.info-value {
    display: block;
}


.info-title {
    color: var(--text);

    font-size: 14px;

    margin-bottom: 7px;
}


.info-value {
    color: var(--text-muted);

    font-size: 13px;

    line-height: 1.5;
}


/* -------------------- */
/* BOUTON */
/* -------------------- */

.about-button {
    width: fit-content;

    padding: 13px 22px;

    border: 1px solid var(--border);

    border-radius: 30px;

    color: var(--text);

    text-decoration: none;

    font-size: 12px;

    transition: 0.3s ease;
}


.about-button:hover {
    background: var(--burgundy);

    border-color: var(--burgundy);

    transform: translateY(-2px);
}


/* -------------------- */
/* IMAGE ABOUT */
/* -------------------- */

.about-image {
    position: relative;

    display: flex;

    align-items: center;
    justify-content: center;
}


.about-image img {
    position: relative;

    z-index: 2;

    width: 65%;

    aspect-ratio: 3 / 4;

    object-fit: cover;

    border: 1px solid var(--border);

    border-radius: 5px;

    filter: grayscale(20%) brightness(0.8);

    box-shadow:
        0 30px 70px rgba(0, 0, 0, 0.5);
}


/* Carré vert derrière */

.about-image-decoration {
    position: absolute;

    z-index: 1;

    width: 55%;

    aspect-ratio: 1;

    background: var(--green);

    opacity: 0.6;

    border-radius: 8px;

    transform: translate(
        90px,
        70px
    );
}


/* Petit texte manuscrit */

.about-note {
    position: absolute;

    z-index: 3;

    right: 5%;

    bottom: 15%;

    color: var(--text);

    font-family: Georgia, serif;

    font-style: italic;

    font-size: 13px;

    line-height: 1.5;

    transform: rotate(-8deg);
}

/* -------------------- */
/* PROJECTS */
/* -------------------- */

.projects {
    padding: 120px 80px;

    border-top: 1px solid var(--border);
}


/* Header */

.projects-header {
    display: flex;

    align-items: flex-end;
    justify-content: space-between;

    margin-bottom: 60px;
}


.projects-header h2 {
    max-width: 600px;

    font-family: "DM Serif Display", serif;

    font-size: clamp(35px, 4vw, 55px);

    font-weight: 400;

    line-height: 1.05;

    margin-top: 15px;
}


.projects-link {
    color: var(--text-muted);

    text-decoration: none;

    font-size: 12px;

    border-bottom: 1px solid var(--border);

    padding-bottom: 6px;

    transition: 0.3s ease;
}


.projects-link:hover {
    color: var(--text);
}


/* -------------------- */
/* GRID */
/* -------------------- */

.projects-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 60px 30px;
}


/* -------------------- */
/* CARD */
/* -------------------- */

.project-card {
    min-width: 0;
}


/* Image */

.project-image {
    position: relative;

    height: 500px;

    overflow: hidden;

    background: var(--bg-secondary);

    border: 1px solid var(--border);
}


.project-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    filter: brightness(0.75);

    transition:
        transform 0.6s ease,
        filter 0.6s ease;
}


/* Hover image */

.project-card:hover .project-image img {
    transform: scale(1.04);

    filter: brightness(0.9);
}


/* -------------------- */
/* ARROW */
/* -------------------- */

.project-arrow {
    position: absolute;

    right: 20px;
    bottom: 20px;

    width: 50px;
    height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: var(--burgundy);

    color: white;

    text-decoration: none;

    font-size: 18px;

    opacity: 0;

    transform: translateY(10px);

    transition: 0.3s ease;
}


.project-card:hover .project-arrow {
    opacity: 1;

    transform: translateY(0);
}


/* -------------------- */
/* INFOS */
/* -------------------- */

.project-info {
    display: flex;

    align-items: flex-start;
    justify-content: space-between;

    padding-top: 20px;
}


.project-number {
    color: var(--text-muted);

    font-size: 10px;

    letter-spacing: 2px;

    margin-bottom: 8px;
}


.project-info h3 {
    font-family: "DM Serif Display", serif;

    font-size: 25px;

    font-weight: 400;
}


/* -------------------- */
/* TAGS */
/* -------------------- */

.project-tags {
    display: flex;

    gap: 8px;
}


.project-tags span {
    padding: 7px 11px;

    border: 1px solid var(--border);

    border-radius: 30px;

    color: var(--text-muted);

    font-size: 10px;
}

/* -------------------- */
/* SKILLS */
/* -------------------- */

.skills {
    padding: 120px 80px;

    border-top: 1px solid var(--border);
}


/* Header */

.skills-header {
    max-width: 700px;

    margin-bottom: 70px;
}


.skills-header h2 {
    font-family: "DM Serif Display", serif;

    font-size: clamp(45px, 5vw, 70px);

    font-weight: 400;

    line-height: 1;

    margin-top: 15px;

    margin-bottom: 25px;
}


.skills-intro {
    max-width: 500px;

    color: var(--text-muted);

    font-size: 14px;

    line-height: 1.8;
}


/* Liste */

.skills-list {
    border-top: 1px solid var(--border);
}


/* Compétence */

.skill {
    display: grid;

    grid-template-columns: 80px 1fr 1fr;

    gap: 40px;

    align-items: center;

    padding: 35px 0;

    border-bottom: 1px solid var(--border);

    transition: 0.3s ease;
}


/* Numéro */

.skill-number {
    color: var(--burgundy-light);

    font-size: 12px;

    letter-spacing: 2px;
}


/* Partie principale */

.skill-main h3 {
    font-family: "DM Serif Display", serif;

    font-size: 28px;

    font-weight: 400;

    margin-bottom: 8px;
}


.skill-main p {
    max-width: 400px;

    color: var(--text-muted);

    font-size: 13px;

    line-height: 1.6;
}


/* Tags */

.skill-tags {
    display: flex;

    justify-content: flex-end;

    flex-wrap: wrap;

    gap: 8px;
}


.skill-tags span {
    padding: 8px 13px;

    border: 1px solid var(--border);

    border-radius: 30px;

    color: var(--text-muted);

    font-size: 11px;

    transition: 0.3s ease;
}


/* Hover */

.skill:hover {
    padding-left: 15px;

    background: rgba(255, 255, 255, 0.015);
}


.skill:hover .skill-tags span {
    border-color: rgba(169, 24, 59, 0.5);

    color: var(--text);
}

/* -------------------- */
/* CONTACT */
/* -------------------- */

.contact {
    position: relative;

    padding: 140px 80px;

    border-top: 1px solid var(--border);

    overflow: hidden;

    background:
        radial-gradient(
            circle at 85% 50%,
            rgba(133, 15, 43, 0.18),
            transparent 35%
        );
}


/* Header */

.contact-header {
    max-width: 850px;

    margin-bottom: 80px;
}


.contact-header h2 {
    font-family: "DM Serif Display", serif;

    font-size: clamp(55px, 8vw, 110px);

    font-weight: 400;

    line-height: 0.95;

    margin-top: 15px;

    margin-bottom: 30px;
}


.contact-header h2 span {
    color: var(--burgundy-light);

    display: block;
}


.contact-intro {
    max-width: 500px;

    color: var(--text-muted);

    font-size: 14px;

    line-height: 1.8;
}


/* -------------------- */
/* CONTACT CONTENT */
/* -------------------- */

.contact-content {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 50px;

    padding-top: 40px;

    border-top: 1px solid var(--border);
}


/* Infos */

.contact-info {
    display: flex;

    gap: 80px;
}


.contact-item {
    min-width: 160px;
}


.contact-label {
    display: block;

    color: var(--text-muted);

    font-size: 9px;

    letter-spacing: 3px;

    margin-bottom: 12px;
}


.contact-item a,
.contact-item p {
    color: var(--text);

    text-decoration: none;

    font-size: 13px;

    line-height: 1.6;
}


.contact-item a {
    transition: color 0.3s ease;
}


.contact-item a:hover {
    color: var(--burgundy-light);
}


/* Réseaux */

.contact-socials {
    display: flex;

    flex-direction: column;

    gap: 5px;
}


/* -------------------- */
/* GROS BOUTON */
/* -------------------- */

.contact-button {
    width: 160px;
    height: 160px;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 10px;

    flex-shrink: 0;

    border-radius: 50%;

    background: var(--burgundy);

    color: white;

    text-decoration: none;

    font-size: 13px;

    transition:
        transform 0.4s ease,
        background 0.4s ease;
}


.contact-button span {
    font-size: 20px;
}


.contact-button:hover {
    transform: scale(1.08);

    background: var(--burgundy-light);
}

/* -------------------- */
/* FOOTER */
/* -------------------- */

.footer {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 30px 80px;

    border-top: 1px solid var(--border);

    color: var(--text-muted);

    font-size: 11px;
}


.footer-logo {
    color: var(--text);

    font-size: 20px;

    font-weight: bold;
}


.footer p {
    margin: 0;
}


.footer a {
    color: var(--text-muted);

    text-decoration: none;

    transition: color 0.3s ease;
}


.footer a:hover {
    color: var(--text);
}
Et pour mobile :

    .footer {
        padding: 25px;

        flex-direction: column;

        gap: 15px;
    }

    @keyframes fadeUp {

    from {
        opacity: 0;

        transform: translateY(30px);
    }

    to {
        opacity: 1;

        transform: translateY(0);
    }

}


.hero-content {
    animation: fadeUp 1s ease forwards;
}

.hero-image {
    animation: fadeUp 1s ease 0.2s forwards;

    opacity: 0;
}
